# Frontend environment variables
# Copy this to .env for local development, or set in Vercel dashboard for staging/production

# Backend API URL
VITE_API_URL=http://localhost:8000

# Clerk authentication (get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# WorkOS authentication
VITE_WORKOS_CLIENT_ID=client_...

# Development only: set true to bypass frontend auth guards locally
VITE_DEV_BYPASS_AUTH=false

# PostHog analytics (get from PostHog → Project Settings → Project API Key)
VITE_PUBLIC_POSTHOG_TOKEN=phc_...
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
